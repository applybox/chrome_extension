# API base URL (must include /api suffix, same as frontend NEXT_PUBLIC_API_URL)
VITE_API_URL=https://api.applybox.co.uk/api

# Frontend URL for SSO callback (same origin as web app /callback page)
VITE_FRONTEND_URL=https://app.applybox.co.uk

# For local development:
# VITE_API_URL=http://localhost:8000/api
# VITE_FRONTEND_URL=http://localhost:3010
